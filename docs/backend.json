
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Representa um cliente da barbearia.",
      "properties": {
        "name": { "type": "string", "description": "Nome do cliente." },
        "phone": { "type": "string", "description": "Telefone do cliente, usado como identificador único." },
        "totalCortes": { "type": "number", "description": "Total de cortes já realizados na barbearia." },
        "cortesAtuais": { "type": "number", "description": "Contador de cortes para o próximo giro (0 a 5)." },
        "girosDisponiveis": { "type": "number", "description": "Quantidade de giros disponíveis na roleta SPIN HILLS." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp de quando o cliente foi cadastrado." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp da última atualização do documento." }
      },
      "required": ["name", "phone", "totalCortes", "cortesAtuais", "girosDisponiveis", "createdAt", "updatedAt"]
    },
    "Rule": {
      "title": "Rule",
      "type": "object",
      "description": "Define as regras para ganhar giros na roleta.",
      "properties": {
        "tipo": { "type": "string", "enum": ["indicacao", "instagram", "fidelidade"], "description": "Tipo da regra." },
        "descricao": { "type": "string", "description": "Descrição da regra para o cliente." },
        "ativo": { "type": "boolean", "description": "Se a regra está ativa ou não." },
        "limitePorUsuario": { "type": "number", "description": "Quantas vezes um usuário pode completar essa regra (ex: 1 para instagram)." }
      },
      "required": ["tipo", "descricao", "ativo"]
    },
    "Prize": {
      "title": "Prize",
      "type": "object",
      "description": "Representa um prêmio ganho por um usuário.",
      "properties": {
        "type": { "type": "string", "enum": ["corte_gratis", "hidratacao", "esfoliacao", "sobrancelha"], "description": "Tipo do prêmio ganho." },
        "title": { "type": "string", "description": "Nome do prêmio (ex: 'Corte Grátis')." },
        "description": { "type": "string", "description": "Descrição do prêmio." },
        "imageUrl": { "type": "string", "description": "URL de uma imagem para o prêmio." },
        "status": { "type": "string", "enum": ["active", "used", "expired"], "description": "Status atual do prêmio." },
        "validityDays": { "type": "number", "description": "Número de dias que o prêmio é válido após ser ganho." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp de quando o prêmio foi ganho." },
        "expiresAt": { "type": "string", "format": "date-time", "description": "Timestamp de quando o prêmio expira." },
        "usedAt": { "type": "string", "format": "date-time", "description": "Timestamp de quando o prêmio foi utilizado." },
        "usedByBarberId": { "type": "string", "description": "ID do barbeiro que validou o uso do prêmio." }
      },
      "required": ["type", "title", "status", "validityDays", "createdAt", "expiresAt"]
    },
    "Barber": {
        "title": "Barber",
        "type": "object",
        "description": "Representa um barbeiro que pode validar ações.",
        "properties": {
            "name": { "type": "string", "description": "Nome do barbeiro." },
            "pin": { "type": "string", "description": "PIN numérico para validação." }
        },
        "required": ["name", "pin"]
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "schema": { "$ref": "#/entities/User" } }
      },
      {
        "path": "/users/{userId}/prizes/{prizeId}",
        "definition": {
          "schema": { "$ref": "#/entities/Prize" },
          "description": "Subcoleção de prêmios pertencentes a um usuário específico."
        }
      },
      {
        "path": "/rules/{ruleId}",
        "definition": { "schema": { "$ref": "#/entities/Rule" } }
      },
      {
        "path": "/barbers/{barberId}",
        "definition": { "schema": { "$ref": "#/entities/Barber" } }
      }
    ]
  }
}
]
]></content>
  </change>
  <change>
    <file>firestore.rules</file>
    <content><![CDATA[rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      // For now, we are not using Firebase Auth, so this is always true.
      // Security is handled by barber PINs at the application level.
      return true;
    }

    match /users/{userId} {
      // Anyone can create a user (sign up).
      // Reading and updating will be handled by the application logic for now.
      // In a real scenario with auth, reads would be restricted to the user themselves or barbers.
      allow read, write: if true; 

      match /prizes/{prizeId} {
        // Allow reading prizes for a specific user.
        // Writes will be handled by transactions in backend logic for security.
        allow read, write: if true; 
      }
    }

    match /rules/{ruleId} {
      // Rules are read-only for clients. Only admins should edit them.
      allow read: if true;
      allow write: if false; // To be managed via Firebase Console by admin
    }

    match /barbers/{barberId} {
      // Barbers info can be read by the app to validate PINs.
      // Only admins should edit them.
      allow read: if true;
      allow write: if false; // To be managed via Firebase Console by admin
    }

    // Collections for future implementation (cuts, spins, logs)
    // By default, they are locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
