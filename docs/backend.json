
{
  "entities": {
    "client": {
      "title": "Client",
      "description": "Represents a client of the barbershop.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Client's full name."
        },
        "phone": {
          "type": "string",
          "description": "Client's phone number."
        },
        "points": {
          "type": "number",
          "description": "Current loyalty points balance."
        },
        "cuts": {
          "type": "number",
          "description": "Total number of cuts."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the client was created."
        },
        "lastCutAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last cut."
        }
      },
      "required": ["name", "phone", "points", "cuts", "createdAt"]
    },
    "cut": {
      "title": "Cut",
      "description": "Represents a single haircut service record.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "Reference to the client document."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the cut was registered."
        },
        "pointsGenerated": {
          "type": "number",
          "description": "Points generated by this cut."
        }
      },
      "required": ["clientId", "date", "pointsGenerated"]
    },
    "reward": {
      "title": "Reward",
      "description": "A reward that can be redeemed with points.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the reward."
        },
        "pointsRequired": {
          "type": "number",
          "description": "Points required to redeem."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the reward is currently active."
        }
      },
      "required": ["title", "pointsRequired", "active"]
    },
    "redeem": {
      "title": "Redeem",
      "description": "A record of a client redeeming a reward.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "Reference to the client document."
        },
        "rewardId": {
          "type": "string",
          "description": "Reference to the reward document."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of when the reward was redeemed."
        }
      },
      "required": ["clientId", "rewardId", "date"]
    },
     "admin": {
      "title": "Admin",
      "description": "Represents an admin user with elevated privileges.",
      "type": "object",
      "properties": {
        "isAdmin": {
          "type": "boolean"
        }
      },
      "required": ["isAdmin"]
    }
  },
  "auth": {
    "providers": ["phone"]
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/client" },
      "description": "Stores individual client data."
    },
    "/cuts/{cutId}": {
      "schema": { "$ref": "#/entities/cut" },
      "description": "Stores records of every cut."
    },
    "/rewards/{rewardId}": {
      "schema": { "$ref": "#/entities/reward" },
      "description": "List of available rewards."
    },
    "/redeems/{redeemId}": {
      "schema": { "$ref": "#/entities/redeem" },
      "description": "History of all redeemed rewards."
    },
     "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/admin" },
      "description": "Admin users for role-based access control."
    }
  }
}
