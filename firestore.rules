
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      // For now, we are not using Firebase Auth, so this is always true.
      // Security is handled by barber PINs at the application level.
      return true;
    }

    match /users/{userId} {
      // Anyone can create a user (sign up).
      // Reading and updating will be handled by the application logic for now.
      allow read, write: if true; 
    }

    match /prizes/{prizeId} {
      // Allow reading and writing prizes.
      // In a real app with auth, read would be restricted to the prize owner or barbers.
      // Write would be restricted (e.g., only can write 'status' field).
      allow read, write: if true;
    }

    match /rules/{ruleId} {
      // Rules are read-only for clients. Only admins should edit them.
      allow read: if true;
      allow write: if false; // To be managed via Firebase Console by admin
    }

    match /barbers/{barberId} {
      // Barbers info can be read by the app to validate PINs.
      // Only admins should edit them.
      allow read: if true;
      allow write: if false; // To be managed via Firebase Console by admin
    }

    match /cuts/{cutId} {
      // Allow the app to create documents when a barber confirms a cut.
      allow read, write: if true;
    }

    match /spins/{spinId} {
      // Allow the app to create documents when a spin is granted.
      allow read, write: if true;
    }
  }
}
