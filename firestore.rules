rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Users can read their own data. Creation is open as it's a public signup.
    // Writes should be protected by admin/barber logic (PIN) in Cloud Functions or client-side checks.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn();
      // Updates are tricky. For now, let's lock them down.
      // Real app would need a Cloud Function or barber PIN validation.
      allow update, delete: if false; 
    }

    // Barbers collection should be read-only for clients. Only admins can manage.
    match /barbers/{barberId} {
      allow read: if isSignedIn(); // Maybe needed for admin panel
      allow write: if false; // Managed by admin only
    }

    // Records of cuts, prizes, spins, and logs are sensitive.
    // Clients should only be able to read data related to them.
    // Writes must be done through a secure backend process (triggered by barber PIN).
    match /cuts/{cutId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /prizes/{prizeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    
    match /spins/{spinId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /logs/{logId} {
      allow read: if false; // Logs are for admin audit only
      allow write: if false;
    }
  }
}
